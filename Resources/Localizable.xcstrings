    "state.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the remote input source in sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让远端输入法跟随本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓遠端輸入法跟隨本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートの入力ソースを同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 입력 소스를 동기화합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabequelle des entfernten Macs synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez la source de saisie du Mac distant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza la fuente de entrada del Mac remoto."
          }
        }
      }
    },
    "permission.input.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is allowed, but macOS is not allowing input events yet. Check the app’s permission switch or quit and reopen the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能已授权，但系统尚未允许发送输入事件。请检查此应用的授权开关，或退出后重新打开应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用已授權，但系統尚未允許傳送輸入事件。請檢查此應用程式的授權開關，或結束後重新開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティは許可済みですが、macOS が入力イベントを許可していません。権限スイッチを確認するか、アプリを終了して開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용은 허용되었지만 macOS가 입력 이벤트를 아직 허용하지 않습니다. 앱 권한을 확인하거나 앱을 종료한 후 다시 여세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen sind erlaubt, aber macOS lässt noch keine Eingabeereignisse zu. Prüfe den Berechtigungsschalter oder starte die App neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité est autorisée, mais macOS n’autorise pas encore les événements de saisie. Vérifiez l’autorisation ou quittez puis rouvrez l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La accesibilidad está permitida, pero macOS aún no permite eventos de entrada. Revisa el permiso de la app o ciérrala y vuelve a abrirla."
          }
        }
      }
    },
    "permission.accessibility.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → Privacy & Security, allow %@ to control this Mac. If its switch is already on, remove the old entry and add the current app from Applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 隐私与安全性中，允许“%@”控制此 Mac。若开关已开启，请移除旧条目，再添加“应用程序”中的当前应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 → 隱私權與安全性中，允許「%@」控制此 Mac。若開關已開啟，請移除舊項目，再加入「應用程式」中的目前 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティで、%@によるMacの操作を許可してください。すでにオンの場合は古い項目を削除し、「アプリケーション」から現在のアプリを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안에서 %@의 Mac 제어를 허용하세요. 이미 켜져 있다면 기존 항목을 제거한 뒤 응용 프로그램 폴더의 현재 앱을 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube %@ unter Systemeinstellungen → Datenschutz & Sicherheit, diesen Mac zu steuern. Ist der Schalter bereits an, entferne den alten Eintrag und füge die aktuelle App aus „Programme“ hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système → Confidentialité et sécurité, autorisez %@ à contrôler ce Mac. Si l’option est déjà activée, supprimez l’ancienne entrée et ajoutez l’app actuelle depuis Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema → Privacidad y seguridad, permite que %@ controle este Mac. Si ya está activado, elimina la entrada anterior y añade la app actual desde Aplicaciones."
          }
        }
      }
    },
