    "help.login.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app at login. Sync starts paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后打开应用，同步默认暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後開啟應用程式，同步預設暫停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動します。同期は一時停止状態で始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 앱을 엽니다. 동기화는 일시 정지 상태로 시작합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App bei der Anmeldung öffnen. Die Synchronisierung startet pausiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’app à la connexion. La synchronisation reste en pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app al iniciar sesión. La sincronización empieza en pausa."
          }
        }
      }
    },
    "about.purpose.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep remote input in sync"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让远端输入法跟随本机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓遠端輸入法跟隨本機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートの入力を同期"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 입력 동기화"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernte Eingabe synchron halten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser la saisie distante"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener sincronizada la entrada remota"
          }
        }
      }
    },
    "about.purpose.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps remote input follow this Mac through macOS Screen Sharing. No remote installation is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 macOS 自带屏幕共享，让远端输入法跟随本机，远端无需安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 macOS 內建螢幕共享，讓遠端輸入法跟隨本機，遠端無需安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の画面共有を通じてリモートの入力ソースを同期します。リモート側へのインストールは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 화면 공유를 통해 원격 입력 소스가 이 Mac을 따르도록 돕습니다. 원격 설치는 필요하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert die entfernte Eingabe über die macOS-Bildschirmfreigabe. Keine Installation auf dem entfernten Mac erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide la saisie distante à suivre ce Mac via Partage d’écran. Aucune installation distante n’est nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a sincronizar la entrada remota mediante Compartir Pantalla de macOS. No requiere instalación remota."
          }
        }
      }
    },
    "about.window.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the current window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随当前窗口"
          }
        },
        "zh-Hant": {
