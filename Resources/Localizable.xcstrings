    "setup.local.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the remote Mac, then open Edit in the local Screen Sharing menu bar and select Sync Keyboard Language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接远端 Mac 后，点击屏幕顶部菜单栏的“编辑”，勾选“同步键盘语言”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接遠端 Mac 後，點選螢幕頂部選單列的「編輯」，勾選「同步鍵盤語言」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続後、この Mac の画面共有の「編集」メニューで「キーボードの言語を同期」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 후 이 Mac의 화면 공유 메뉴 막대에서 ‘편집’ → ‘키보드 언어 동기화’를 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde den entfernten Mac und wähle in der lokalen Bildschirmfreigabe Bearbeiten → Tastatursprache synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez le Mac distant, puis choisissez Édition → Synchroniser la langue de clavier dans le Partage d’écran local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el Mac remoto y elige Edición → Sincronizar idioma del teclado en Compartir Pantalla de este Mac."
          }
        }
      }
    },
    "setup.auto.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or let the app enable it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以自动开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以自動開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリから有効にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 자동으로 켜기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder von der App aktivieren lassen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou laisser l’app l’activer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O dejar que la app lo active"
          }
        }
      }
    },
    "setup.auto.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@ in Accessibility, then choose Keyboard Language Sync again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在辅助功能中允许“%@”，然后再次点击本工具的“同步键盘语言”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輔助使用中允許「%@」，然後再次點選本工具的「同步鍵盤語言」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティで %@ を許可してから、もう一度キーボードの言語の同期を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용에서 %@을(를) 허용한 후 키보드 언어 동기화 켜기를 다시 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube %@ in den Bedienungshilfen und wähle erneut „Tastatursprache synchronisieren“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez %@ dans Accessibilité, puis activez à nouveau la synchronisation du clavier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite %@ en Accesibilidad y vuelve a activar la sincronización del teclado."
          }
        }
      }
    },
