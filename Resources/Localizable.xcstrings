    "state.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Screen Sharing and switch input sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切回屏幕共享，切换本机输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切回螢幕共享，切換本機輸入法。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面共有に戻り、入力ソースを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 공유로 돌아가 입력 소스를 전환하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zur Bildschirmfreigabe und ändere die Eingabequelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez au Partage d’écran et changez de source de saisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a Compartir Pantalla y cambia la fuente de entrada."
          }
        }
      }
    },
