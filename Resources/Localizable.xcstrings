    },
    "about.window.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the current shared-screen bounds to locate the menu, without a fixed device name or window size."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前屏幕共享窗口的位置和画面范围定位菜单，不绑定设备名称或固定窗口大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前螢幕共享視窗的位置和畫面範圍定位選單，不綁定裝置名稱或固定視窗大小。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の共有画面の位置と範囲からメニューを探します。デバイス名やウインドウサイズは固定しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 공유 화면의 위치와 범위로 메뉴를 찾습니다. 기기 이름이나 윈도우 크기는 고정하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menüposition wird aus dem aktuellen geteilten Bild ermittelt, ohne festen Gerätenamen oder feste Fenstergröße."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menu est repéré à partir des limites actuelles de l’écran partagé, sans nom d’appareil ni taille de fenêtre imposés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Localiza el menú según los límites de la pantalla compartida actual, sin fijar nombre de dispositivo ni tamaño de ventana."
          }
        }
      }
    },
