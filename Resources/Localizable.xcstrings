    "help.prepare.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the remote Mac, then choose Settings → Keyboard Language Sync. You can also enable it in Screen Sharing’s Edit menu on your local Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接远端 Mac，然后点击“设置 → 同步键盘语言”。也可在本机屏幕共享的“编辑”菜单中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接遠端 Mac，然後點擊「設定 → 同步鍵盤語言」。也可在本機螢幕共享的「編輯」選單中開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートMacに接続し、「設定 → キーボード言語の同期」を選択します。手元の画面共有の「編集」メニューからも有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 Mac에 연결한 뒤 “설정 → 키보드 언어 동기화”를 선택하세요. 로컬 화면 공유의 편집 메뉴에서도 켤 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem entfernten Mac verbinden und „Einstellungen → Tastatursprache synchronisieren“ wählen. Alternativ im Menü „Bearbeiten“ der lokalen Bildschirmfreigabe aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au Mac distant, puis choisissez « Réglages → Synchronisation de la langue du clavier ». Cette option est aussi accessible dans le menu Édition de Partage d’écran sur le Mac local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate al Mac remoto y elige «Ajustes → Sincronización del idioma del teclado». También puedes activarlo en el menú Edición de Compartir Pantalla del Mac local."
          }
        }
      }
    },
    "help.enable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Enable Sync in this app, then return to the Screen Sharing window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本工具菜单中点击“开启同步”，再回到屏幕共享窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在本工具選單中點選「開啟同步」，再回到螢幕共享視窗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリで同期をオンにして、画面共有ウインドウに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서 ‘동기화 켜기’를 선택한 후 화면 공유 윈도우로 돌아가세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Synchronisierung in dieser App und wechsle zurück zur Bildschirmfreigabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la synchronisation dans cette app, puis revenez à la fenêtre de Partage d’écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la sincronización en esta app y vuelve a la ventana de Compartir Pantalla."
          }
        }
      }
    },
    "help.key.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch your input source"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换本机输入法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換本機輸入法"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースを切り替える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 소스 전환"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabequelle wechseln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de source de saisie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la fuente de entrada"
          }
        }
      }
    },
    "help.key.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch your input source as usual, wait about a second, then type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照常切换输入法，等约 1 秒再输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照常切換輸入法，等約 1 秒再輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもどおり入力ソースを切り替え、約1秒待ってから入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소처럼 입력 소스를 전환하고 약 1초 후 입력하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie gewohnt die Eingabequelle wechseln, etwa eine Sekunde warten und dann tippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de source de saisie comme d’habitude, attendez environ une seconde, puis tapez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la fuente de entrada como de costumbre, espera un segundo y escribe."
          }
        }
      }
    },
    "help.login.heading": {
      "extractionState": "manual",
