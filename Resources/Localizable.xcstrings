{
  "sourceLanguage": "en",
  "strings": {
    "permission.input.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input control unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入控制暂不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入控制暫不可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力制御を利用できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 제어를 사용할 수 없음"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabesteuerung nicht verfügbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle de saisie indisponible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control de entrada no disponible"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission not active"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限尚未生效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限尚未生效"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が有効になっていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 적용되지 않음"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigung noch nicht aktiv"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation inactive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso aún no activo"
          }
        }
      }
    },
    "permission.input.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is not active yet. Try restarting the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限尚未生效，请重启应用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限尚未生效，請重新啟動後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限がまだ有効ではありません。アプリを再起動してお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 아직 적용되지 않았습니다. 앱을 다시 실행해 보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff noch nicht aktiv. App neu starten und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation pas encore active. Essayez de relancer l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso aún no está activo. Prueba a reiniciar la app."
          }
        }
      }
    },
    "permission.accessibility.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this version of the app in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许当前版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許目前版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で現在のバージョンを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 현재 버전의 앱을 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube diese App-Version in den Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez cette version dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza esta versión en Ajustes del Sistema."
          }
        }
      }
    },
