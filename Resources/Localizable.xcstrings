    "about.behavior.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A remote menu briefly appears during a switch. Use the activity log to investigate missed switches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换时远端菜单会短暂闪现。运行日志可用于排查未同步的情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換時遠端選單會短暫閃現。執行記錄可用於排查未同步的情況。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え時にリモートのメニューが一瞬表示されます。同期されない場合は動作ログを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 시 원격 메뉴가 잠깐 나타납니다. 동기화되지 않으면 실행 로그를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechsel erscheint kurz ein entferntes Menü. Fehlende Wechsel lassen sich im Protokoll untersuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menu distant apparaît brièvement lors du changement. Le journal permet d’examiner les synchronisations manquées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar aparece brevemente un menú remoto. El registro permite investigar cambios no sincronizados."
          }
        }
      }
    },
